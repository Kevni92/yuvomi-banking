# Copy this file to deploy/.env and keep the copy outside Git.

# Exact public origin used by the Yuvomi browser and Enable Banking callback.
PUBLIC_ORIGIN=https://yuvomi.example.com

# The existing Yuvomi Compose project normally creates <project>_default.
# Override this when the real network has another name.
YUVOMI_NETWORK=yuvomi_default
YUVOMI_INTERNAL_URL=http://yuvomi:3000
PROXY_NETWORK=document_automation_proxy

BANKING_DATA_VOLUME=yuvomi-banking-data

# Keep sandbox until the Enable Banking production application is ready.
ENABLE_BANKING_ENV=sandbox
ENABLE_BANKING_API_URL=https://api.enablebanking.com
ENABLE_BANKING_APPLICATION_ID=

# Optional: leave empty to configure OpenAI later in Banking settings.
OPENAI_MODEL=

# Optional Banking Web Push configuration. Keep private values in this file
# only if it is protected with mode 0600, or add file-backed secret support to
# your deployment before enabling push delivery.
BANKING_VAPID_SUBJECT=mailto:admin@example.com
BANKING_VAPID_PUBLIC_KEY=
BANKING_VAPID_PRIVATE_KEY=
