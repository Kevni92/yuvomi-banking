PORT=3100

# Interne URL des lokalen Yuvomi-Servers.
YUVOMI_INTERNAL_URL=http://127.0.0.1:3000

# Öffentliche Origin, über die Browser Yuvomi + Sidecar sehen.
PUBLIC_ORIGIN=http://localhost:8080

# Eigene Banking-Datenbank.
BANKING_DB_PATH=../data/banking.db

# Enable Banking - zunächst Sandbox.
ENABLE_BANKING_ENV=sandbox
ENABLE_BANKING_API_URL=https://api.enablebanking.com
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=../secrets/enablebanking-private.pem

# Geheimnisse niemals committen.
COUNTERPARTY_HMAC_SECRET=
BANKING_DATA_ENCRYPTION_KEY=
OPENAI_API_KEY=

# OpenAI-Modell später bewusst festlegen.
OPENAI_MODEL=
